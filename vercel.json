{
  "rewrites": [{ "source": "/((?!content/|icons/|manifest.webmanifest|sw.js|assets/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/content/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
